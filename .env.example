# github.com/is7qin/c3api 部署环境变量（docker compose --env-file .env -f deploy/compose.yml 读取）
# 注意：compose v2.24+ 用 -f 指定文件时项目目录切到 deploy/，不再自动读当前目录的
# .env——须显式 --env-file .env（.env 位于根目录，与 README 用法一致）。
# 用法：cp .env.example .env 后按需填写（.env 不进 git）

# 必填：管理端 token（openssl rand -hex 16 生成）
ADMIN_TOKEN=

# 必填：PG 密码（生产必改，默认 c3api 仅限本地）
POSTGRES_PASSWORD=c3api

# 可选：对外端口（默认 18080）
PORT=18080

# 必填：JWT 密钥（缺失启动失败；openssl rand -hex 32 生成）
AUTH_JWT_SECRET=
